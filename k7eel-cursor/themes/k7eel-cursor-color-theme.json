{
  "$schema": "vscode://schemas/color-theme",
  "name": "K7EEL Cursor",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#DAD7CF",
    "descriptionForeground": "#98958D",
    "errorForeground": "#F06F67",
    "focusBorder": "#E27A59",
    "contrastBorder": "#00000000",
    "widget.shadow": "#00000066",

    "editor.background": "#1F1F1D",
    "editor.foreground": "#DAD7CF",
    "editorCursor.foreground": "#F08361",
    "editor.lineHighlightBackground": "#252523",
    "editorLineNumber.foreground": "#625F59",
    "editorLineNumber.activeForeground": "#E27A59",
    "editor.selectionBackground": "#E27A5945",
    "editor.inactiveSelectionBackground": "#E27A5928",
    "editor.selectionHighlightBackground": "#E27A5920",
    "editor.wordHighlightBackground": "#F06AA620",
    "editor.wordHighlightStrongBackground": "#F06AA635",
    "editorIndentGuide.background1": "#343431",
    "editorIndentGuide.activeBackground1": "#65615B",
    "editorWhitespace.foreground": "#3D3B37",
    "editorRuler.foreground": "#343431",
    "editorBracketMatch.background": "#E27A5920",
    "editorBracketMatch.border": "#E27A59",
    "editorBracketHighlight.foreground1": "#F08361",
    "editorBracketHighlight.foreground2": "#E6B85F",
    "editorBracketHighlight.foreground3": "#82C4BE",
    "editorBracketHighlight.foreground4": "#F06AA6",
    "editorBracketHighlight.foreground5": "#A8D987",
    "editorBracketHighlight.foreground6": "#AFA1D8",

    "editorGroupHeader.tabsBackground": "#242422",
    "editorGroupHeader.noTabsBackground": "#1F1F1D",
    "editorGroup.border": "#343431",
    "tab.activeBackground": "#1F1F1D",
    "tab.activeForeground": "#FAF9F5",
    "tab.inactiveBackground": "#242422",
    "tab.inactiveForeground": "#8D8A83",
    "tab.hoverBackground": "#292927",
    "tab.activeBorderTop": "#E27A59",
    "tab.border": "#343431",

    "sideBar.background": "#252523",
    "sideBar.foreground": "#DAD7CF",
    "sideBar.border": "#343431",
    "sideBarTitle.foreground": "#FAF9F5",
    "sideBarSectionHeader.background": "#2B2B28",
    "sideBarSectionHeader.foreground": "#DAD7CF",
    "sideBarSectionHeader.border": "#383834",
    "sideBarActivityBarTop.border": "#343431",

    "activityBar.background": "#1B1B19",
    "activityBar.foreground": "#F08361",
    "activityBar.inactiveForeground": "#85817A",
    "activityBar.border": "#343431",
    "activityBar.activeBorder": "#F08361",
    "activityBarBadge.background": "#F06AA6",
    "activityBarBadge.foreground": "#1F1F1D",

    "titleBar.activeBackground": "#1F1F1D",
    "titleBar.activeForeground": "#FAF9F5",
    "titleBar.inactiveBackground": "#1F1F1D",
    "titleBar.inactiveForeground": "#85817A",
    "titleBar.border": "#343431",
    "commandCenter.background": "#242422",
    "commandCenter.foreground": "#DAD7CF",
    "commandCenter.border": "#4A4741",
    "commandCenter.activeBackground": "#2E2D2A",

    "statusBar.background": "#1B1B19",
    "statusBar.foreground": "#CFCBC2",
    "statusBar.border": "#343431",
    "statusBarItem.hoverBackground": "#343431",
    "statusBarItem.remoteBackground": "#E27A59",
    "statusBarItem.remoteForeground": "#1F1F1D",
    "statusBarItem.errorBackground": "#D85F59",
    "statusBarItem.warningBackground": "#D9A94D",

    "panel.background": "#1F1F1D",
    "panel.border": "#373633",
    "panelTitle.activeForeground": "#F08361",
    "panelTitle.inactiveForeground": "#8D8A83",
    "panelTitle.activeBorder": "#E27A59",
    "panelInput.border": "#45433E",

    "terminal.background": "#1F1F1D",
    "terminal.foreground": "#DAD7CF",
    "terminalCursor.foreground": "#F08361",
    "terminal.selectionBackground": "#E27A5945",
    "terminal.border": "#373633",
    "terminal.ansiBlack": "#1F1F1D",
    "terminal.ansiRed": "#E46E67",
    "terminal.ansiGreen": "#9FCB82",
    "terminal.ansiYellow": "#E0B45C",
    "terminal.ansiBlue": "#80A9C8",
    "terminal.ansiMagenta": "#F06AA6",
    "terminal.ansiCyan": "#82BDB8",
    "terminal.ansiWhite": "#DAD7CF",
    "terminal.ansiBrightBlack": "#77746D",
    "terminal.ansiBrightRed": "#F0837A",
    "terminal.ansiBrightGreen": "#B5D58D",
    "terminal.ansiBrightYellow": "#EAC777",
    "terminal.ansiBrightBlue": "#9ABCD3",
    "terminal.ansiBrightMagenta": "#FF83BB",
    "terminal.ansiBrightCyan": "#9CD0CB",
    "terminal.ansiBrightWhite": "#FAF9F5",

    "input.background": "#292927",
    "input.foreground": "#FAF9F5",
    "input.border": "#45433E",
    "input.placeholderForeground": "#77746D",
    "inputOption.activeBorder": "#E27A59",
    "inputValidation.errorBorder": "#E46E67",
    "inputValidation.warningBorder": "#E0B45C",
    "inputValidation.infoBorder": "#82BDB8",

    "editorWidget.background": "#292927",
    "editorWidget.foreground": "#DAD7CF",
    "editorWidget.border": "#45433E",
    "editorSuggestWidget.background": "#292927",
    "editorSuggestWidget.foreground": "#DAD7CF",
    "editorSuggestWidget.border": "#45433E",
    "editorSuggestWidget.selectedBackground": "#3A3834",
    "editorSuggestWidget.highlightForeground": "#F08361",
    "editorHoverWidget.background": "#292927",
    "editorHoverWidget.foreground": "#DAD7CF",
    "editorHoverWidget.border": "#45433E",

    "list.activeSelectionBackground": "#3A3834",
    "list.activeSelectionForeground": "#FAF9F5",
    "list.inactiveSelectionBackground": "#30302D",
    "list.inactiveSelectionForeground": "#DAD7CF",
    "list.hoverBackground": "#30302D",
    "list.hoverForeground": "#FAF9F5",
    "list.highlightForeground": "#F08361",
    "list.focusOutline": "#E27A59",

    "badge.background": "#E27A59",
    "badge.foreground": "#1F1F1D",
    "button.background": "#E27A59",
    "button.foreground": "#1F1F1D",
    "button.hoverBackground": "#F08361",
    "button.secondaryBackground": "#343431",
    "button.secondaryForeground": "#DAD7CF",
    "button.secondaryHoverBackground": "#45433E",

    "scrollbarSlider.background": "#77746D40",
    "scrollbarSlider.hoverBackground": "#77746D60",
    "scrollbarSlider.activeBackground": "#E27A5980",

    "gitDecoration.modifiedResourceForeground": "#E0B45C",
    "gitDecoration.addedResourceForeground": "#9FCB82",
    "gitDecoration.deletedResourceForeground": "#E46E67",
    "gitDecoration.untrackedResourceForeground": "#B5D58D",
    "gitDecoration.renamedResourceForeground": "#82BDB8",
    "gitDecoration.conflictingResourceForeground": "#F06AA6",
    "gitDecoration.ignoredResourceForeground": "#66635D",

    "problemsErrorIcon.foreground": "#E46E67",
    "problemsWarningIcon.foreground": "#E0B45C",
    "problemsInfoIcon.foreground": "#82BDB8",

    "debugConsole.infoForeground": "#82BDB8",
    "debugConsole.warningForeground": "#E0B45C",
    "debugConsole.errorForeground": "#E46E67",
    "debugConsole.sourceForeground": "#9FCB82",

    "agentStatusIndicator.background": "#F06AA6",
    "agentSessionReadIndicator.foreground": "#F06AA6"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#85817A", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new"], "settings": { "foreground": "#F08361" } },
    { "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "keyword.operator.arithmetic"], "settings": { "foreground": "#E27A59" } },
    { "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#F39A79" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace", "entity.name.type.interface"], "settings": { "foreground": "#82C4BE" } },
    { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#E2DED5" } },
    { "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#E2B974" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#B5D58D" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant"], "settings": { "foreground": "#EAC777" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml entity.name.tag"], "settings": { "foreground": "#82C4BE" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#E2B974" } },
    { "scope": ["punctuation.definition.tag", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#A9A59C" } },
    { "scope": ["support.type.property-name.css", "meta.property-name.css", "support.type.property-name.scss", "meta.property-name.scss"], "settings": { "foreground": "#E2B974" } },
    { "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.scss"], "settings": { "foreground": "#82C4BE" } },
    { "scope": ["constant.numeric.css", "constant.numeric.scss", "support.constant.property-value.css", "support.constant.property-value.scss"], "settings": { "foreground": "#EAC777" } },
    { "scope": ["variable.other.php", "variable.other.readwrite.php", "variable.other.global.php"], "settings": { "foreground": "#E2DED5" } },
    { "scope": ["support.function.construct.php", "keyword.control.php", "storage.type.php", "keyword.operator.php"], "settings": { "foreground": "#F08361" } },
    { "scope": ["entity.name.function.php", "support.function.php"], "settings": { "foreground": "#F39A79" } },
    { "scope": ["entity.name.type.class.php", "support.class.php", "entity.name.namespace.php"], "settings": { "foreground": "#82C4BE" } },
    { "scope": ["variable.other.readwrite.js", "variable.other.readwrite.ts", "variable.other.readwrite.tsx", "variable.other.constant.js", "variable.other.constant.ts"], "settings": { "foreground": "#E2DED5" } },
    { "scope": ["entity.name.function.js", "entity.name.function.ts", "entity.name.function.tsx", "support.function.js", "support.function.ts"], "settings": { "foreground": "#F39A79" } },
    { "scope": ["entity.name.type.ts", "entity.name.type.tsx", "entity.name.type.interface.ts", "entity.name.type.class.ts"], "settings": { "foreground": "#82C4BE" } },
    { "scope": ["variable.other.readwrite.global.perl", "variable.other.readwrite.perl", "variable.other.predefined.perl"], "settings": { "foreground": "#E2DED5" } },
    { "scope": ["keyword.control.perl", "storage.type.perl", "keyword.operator.perl"], "settings": { "foreground": "#F08361" } },
    { "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#F39A79", "fontStyle": "bold" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"], "settings": { "foreground": "#B5D58D" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#82BDB8", "fontStyle": "underline" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FAF9F5", "background": "#C95353" } }
  ],
  "semanticTokenColors": {
    "function": "#F39A79",
    "method": "#F39A79",
    "class": "#82C4BE",
    "interface": "#82C4BE",
    "type": "#82C4BE",
    "typeParameter": "#82C4BE",
    "namespace": "#82C4BE",
    "parameter": "#E2DED5",
    "variable": "#E2DED5",
    "property": "#E2B974",
    "enumMember": "#EAC777",
    "enum": "#82C4BE",
    "decorator": "#F06AA6"
  }
}
